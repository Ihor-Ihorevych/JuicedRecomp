<?xml version="1.0" encoding="utf-8"?>
<!-- the version: versionName is what people see (the settings panel shows it), versionCode goes up with every release -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.juiced"
    android:versionCode="14" android:versionName="1.3.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35"/>
    <!-- the renderer: Vulkan 1.1 when the phone has it, else (or when it breaks) OpenGL ES 3.2, which every phone needs -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="false"/>
    <uses-feature android:glEsVersion="0x00030002" android:required="true"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.gamepad" android:required="false"/>
    <!-- the settings panel opens links (Telegram, GitHub): Android 11 and later only lets an app see who can open them if it asks -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
    <application android:label="Juiced" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true" android:hasCode="true"
        android:extractNativeLibs="true" android:allowBackup="false" android:debuggable="true">
        <!-- the launcher: unpacks the game of a selfpack APK on the first start, then opens the game -->
        <activity android:name="io.github.juiced.SetupActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="io.github.juiced.GameActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density|smallestScreenSize"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"/>
    </application>
</manifest>
